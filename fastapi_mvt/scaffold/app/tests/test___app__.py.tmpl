"""Tests for {{app}}. Each test runs in a transaction that is rolled back afterwards."""
{% crud %}

{% auth %}
from {{project}}.auth import auth
from users.models import User
{% end %}
from {{app}}.models import {{Model}}


async def test_{{singular}}_crud(client):
{% auth %}
    user = await User.objects.create(email="tester@example.com", password="!")
    headers = {"Authorization": f"Bearer {auth.create_access_token(user)}"}
{% else %}
    headers = {}
{% end %}

    response = await client.post("/{{url}}", json={"name": "First"}, headers=headers)
    assert response.status_code == 201, response.text
    item_id = response.json()["id"]

    response = await client.get("/{{url}}", params={"q": "fir"})
    assert response.json()["total"] == 1

    response = await client.patch(f"/{{url}}/{item_id}", json={"name": "Renamed"}, headers=headers)
    assert response.json()["name"] == "Renamed"

    response = await client.delete(f"/{{url}}/{item_id}", headers=headers)
    assert response.status_code == 204
    assert (await client.get(f"/{{url}}/{item_id}")).status_code == 404
    assert not await {{Model}}.objects.exists()
{% else %}


async def test_index(client):
    response = await client.get("/{{url}}")
    assert response.status_code == 200
{% end %}
